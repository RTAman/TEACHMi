# Local development only. Copy to .env before starting Compose or Gradle.
DB_NAME=teachmi
DB_USER=teachmi
DB_PASSWORD=teachmi_local_only
DB_PORT=5433

# Enable after configuring a key, an available Gemini text model and A's LearningSourceReader.
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_CONNECT_TIMEOUT_SECONDS=3
GEMINI_REQUEST_TIMEOUT_SECONDS=20
GEMINI_REQUESTS_PER_MINUTE=10
GEMINI_REQUESTS_PER_DAY=100
GEMINI_MEMBER_REQUESTS_PER_DAY=20
GEMINI_MAX_ATTEMPTS=2
GEMINI_MAX_SOURCE_CHARS=16000
GEMINI_MAX_OUTPUT_TOKENS=2048
