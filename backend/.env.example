# Local development only. Copy to .env before starting Compose or Gradle.
DB_NAME=teachmi
DB_USER=teachmi
DB_PASSWORD=teachmi_local_only
DB_PORT=5433

# Login cookie. Keep Secure on in deployed HTTPS environments; local HTTP development turns it off.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Lax
AUTH_SESSION_TTL=7d

# Maximum lecture file size for PDF/PPT/PPTX uploads.
MATERIAL_MAX_FILE_SIZE=20MB

# Enable after configuring a key, an available Gemini text model and A's LearningSourceReader.
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_CONNECT_TIMEOUT_SECONDS=3
GEMINI_REQUEST_TIMEOUT_SECONDS=20
GEMINI_REQUESTS_PER_MINUTE=10
GEMINI_REQUESTS_PER_DAY=100
GEMINI_MEMBER_REQUESTS_PER_DAY=20
GEMINI_MAX_ATTEMPTS=2
GEMINI_MAX_SOURCE_CHARS=16000
GEMINI_MAX_OUTPUT_TOKENS=2048
# B initial/student/reteach replies use min(global cap, interactive cap). C and summary keep the global cap.
GEMINI_INTERACTIVE_MAX_OUTPUT_TOKENS=2048
# Fixed problems/temporary grading: explicit demo only; keep off with real Gemini.
ASSESSMENT_DEMO_ENABLED=false
