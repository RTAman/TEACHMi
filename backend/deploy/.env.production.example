# Copy outside Git, e.g. /etc/teachmi/production.env, chmod 600.
# ops.py ignores inherited deployment variables and resolves this file explicitly.
APP_IMAGE=teachmi-backend:REPLACE_WITH_FULL_COMMIT_SHA
APP_REVISION=REPLACE_WITH_FULL_COMMIT_SHA
TEACHMI_DOMAIN=teachmi.example.invalid
ACME_EMAIL=owner@example.invalid
DB_NAME=teachmi_prod
# Use different random URL-safe passwords of at least 24 characters.
DB_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_ADMIN_PASSWORD
DB_PASSWORD=REPLACE_WITH_RANDOM_APP_PASSWORD

# Start with AI disabled. Enable only after explicit deployment/API approval.
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_CONNECT_TIMEOUT_SECONDS=3
GEMINI_REQUEST_TIMEOUT_SECONDS=40
GEMINI_MAX_OUTPUT_TOKENS=6144
GEMINI_INTERACTIVE_MAX_OUTPUT_TOKENS=2048
GEMINI_REQUESTS_PER_MINUTE=10
GEMINI_REQUESTS_PER_DAY=100
GEMINI_MEMBER_REQUESTS_PER_DAY=20
GEMINI_MAX_ATTEMPTS=2
GEMINI_MAX_SOURCE_CHARS=16000

# Same HTTPS origin: frontend files and /api/* through Caddy.
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAME_SITE=Lax
AUTH_SESSION_TTL=7d
AUTH_LOGIN_MAX_FAILURES=5
AUTH_LOGIN_FAILURE_WINDOW=15m
ASSESSMENT_DEMO_ENABLED=false
MATERIAL_MAX_FILE_SIZE=20MB
