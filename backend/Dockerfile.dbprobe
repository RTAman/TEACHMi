FROM postgres:17-alpine

CMD ["sh", "-c", "echo DB_PROBE_START; if nc -z -w 5 aws-0-ap-southeast-1.pooler.supabase.com 5432; then echo DB_TCP_OK; else echo DB_TCP_FAILED; fi; if PGPASSWORD=\"$DB_PASSWORD\" psql \"host=aws-0-ap-southeast-1.pooler.supabase.com port=5432 dbname=postgres user=$DB_USER sslmode=require connect_timeout=10\" -w -Atqc 'SELECT 1' >/dev/null; then echo DB_PSQL_OK; else echo DB_PSQL_FAILED; fi; sleep 30"]
